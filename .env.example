# 演示模式：不连接海康云眸，使用本地生成的样例相机与图片
DEMO_MODE=true

# 海康云眸开放平台
HIK_CLIENT_ID=
HIK_CLIENT_SECRET=
HIK_BASE_URL=https://api2.hik-cloud.com
HIK_GROUP_NOS=1

# 本地存储
DATA_DIR=./data
DB_PATH=./data/cam_angle.db
# 源图、缩略图、遮挡标注、CV/VLM 中间结果和最终 JSON 都保存在这里。
ARTIFACT_ROOT=./data/artifacts

# Qwen3-VL 语义巡检（vLLM OpenAI 兼容接口）
VLM_ENABLED=false
VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_MODEL=Qwen3-VL-4B-Instruct-AWQ-4bit
VLM_API_KEY=EMPTY
VLM_TIMEOUT=90
VLM_MAX_IMAGE_SIDE=1280
VLM_JPEG_QUALITY=90
VLM_REVIEW_SCORE=0.09
VLM_MIN_ELEMENT_CONFIDENCE=0.55
VLM_LARGE_OCCLUSION_RATIO=0.35

# 服务端口
HOST=127.0.0.1
PORT=8000

# 巡检调度
PIPELINE_MODE=decoupled
CONCURRENCY=4
CAPTURE_CONCURRENCY=16
INFERENCE_CONCURRENCY=24
